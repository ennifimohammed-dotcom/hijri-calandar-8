<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the "Hijri Date" widget.

  updatePeriodMillis is 0 on purpose: the widget is refreshed by the
  app (WidgetSyncService) on launch, on resume, and whenever a
  relevant setting changes — re-running onUpdate on a system timer
  would only re-display the same cached PNG. A fully-background daily
  refresh (date rollover while the app is closed) is a Phase 2 item.

  targetCellWidth / targetCellHeight are honoured on Android 12+; the
  minWidth / minHeight values cover older launchers. The widget is
  resizable so the user can pick the "small" or "medium" footprint.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_hijri_date"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_hijri_date_desc" />
