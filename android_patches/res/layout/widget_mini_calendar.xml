<?xml version="1.0" encoding="utf-8"?>
<!--
  Native layout for the "Mini Calendar" home-screen widget.
  GENERATED by tools — 6 rows x 7 columns. Every cell, day number
  and event dot has a unique id; MiniCalendarWidgetProvider fills
  them in onUpdate and wires a per-day tap PendingIntent. The 6th
  row is hidden at runtime when the month does not reach it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mc_bg_light"
    android:padding="12dp">

    <!-- Title row: Hijri month/year (primary) + Gregorian (secondary). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="7dp">
        <TextView
            android:id="@+id/mc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#888888" />
        <TextView
            android:id="@+id/mc_greg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="#888888" />
    </LinearLayout>

