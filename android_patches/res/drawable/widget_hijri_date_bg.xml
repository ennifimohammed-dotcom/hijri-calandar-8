<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback background for the "Hijri Date" widget: a royal-green
  rounded rectangle. Only visible before the Flutter-rendered PNG
  lands; once it does, the PNG (which carries its own rounded
  corners) covers this entirely.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:startColor="#06231A"
        android:endColor="#0E4A2D"
        android:angle="135" />
</shape>
