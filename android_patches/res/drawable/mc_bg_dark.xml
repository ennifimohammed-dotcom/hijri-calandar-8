<?xml version="1.0" encoding="utf-8"?>
<!--
  Mini Calendar background — dark theme. Same layer-list shape as the
  light variant; the shadow ground is darker to stay visible against
  the night surface.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow ground -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Card surface (darkSurface), inset bottom to reveal shadow. -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1A2235" />
            <stroke android:width="1dp" android:color="#2A3448" />
        </shape>
    </item>
</layer-list>
